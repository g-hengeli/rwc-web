---
// Navigation component for the Rough Water Cup website
const rwcLogo = '/src/assets/rwc-logo_trans.svg'; 
---

<!-- Navigation -->
<nav class="fixed top-0 w-full bg-white backdrop-blur-md z-50 border-b border-gray-200">
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
		<div class="flex justify-between items-center h-20">
			<div class="flex items-center space-x-3">
				<img src={rwcLogo} alt="RWC Logo" class="h-16 w-16" />
				<span class="text-xl font-bold text-brand-blue">Rough Water Cup</span>
			</div>
		</div>
	</div>
</nav>