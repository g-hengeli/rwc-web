---
// Event Details section component
---

<!-- Event Details Section -->
<section id="event-info" class="min-h-screen bg-brand-gray-light">
	<!-- Secondary Hero Image -->
	<div class="relative h-64 md:h-80 lg:h-96 overflow-hidden">
		<img 
			src="/flintrock-falls-banner.png" 
			alt="Flintrock Falls Golf Course" 
			class="w-full h-full object-cover"
		/>
	</div>
	
	<!-- Content Section -->
	<div class="flex items-center justify-center py-16">
		<div class="text-center">
			<h2 class="text-4xl font-bold text-brand-blue mb-4">Event Details</h2>
			<p class="text-brand-gray-medium mb-8">Registration is now open for Rough Water Cup V</p>
			<a 
				href="https://www.golfgenius.com/pages/11874484085814476996" 
				target="_blank" 
				rel="noopener noreferrer"
				class="inline-block bg-brand-blue hover:bg-brand-blue-dark text-white font-bold py-3 px-8 rounded-lg transition-colors duration-200 shadow-lg hover:shadow-xl"
			>
				Register Now
			</a>
			
			<!-- Title Sponsors Section -->
			<div class="mt-16">
				<h3 class="text-2xl font-semibold text-brand-blue mb-6">Title Sponsors</h3>
				<p class="text-brand-gray-medium mb-8">We extend our sincere gratitude to our title sponsors for their generous support</p>
				<div class="flex flex-col md:flex-row items-center justify-center gap-12">
					<div class="text-center">
						<img 
							src="/src/assets/images/sponsor-jp-asset-mgmt.png" 
							alt="JP Morgan Asset Management" 
							class="h-20 md:h-24 object-contain mb-4"
						/>
						<p class="text-brand-gray-dark font-medium">JP Morgan Asset Management</p>
					</div>
					<div class="text-center">
						<img 
							src="/src/assets/images/sponsor-rfg.jpg" 
							alt="Rembrandt Financial Group, LLC" 
							class="h-20 md:h-24 object-contain mb-4"
						/>
						<p class="text-brand-gray-dark font-medium">Rembrandt Financial Group, LLC</p>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>